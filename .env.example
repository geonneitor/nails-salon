# ============================================================
# Zen Booking — Variables de entorno
# ============================================================
# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA debe commitearse al repo (ver .gitignore).
#
# ¿Dónde conseguir los valores?
#   1) Entra a https://app.supabase.com y abre tu proyecto.
#   2) Ve a Settings -> API.
#   3) Copia:
#      - Project URL     -> NEXT_PUBLIC_SUPABASE_URL
#      - anon public key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#      - service_role key (secret) -> SUPABASE_SERVICE_ROLE_KEY
#   4) En Settings -> General, copia el Project ID -> NEXT_PUBLIC_PROJECT_ID
# ============================================================

# URL pública del proyecto Supabase (Settings -> API -> Project URL).
# Ejemplo: https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública. Es seguro commitear este placeholder porque la clave real
# vive en .env.local y se inyecta en runtime. La anon key se expone al
# navegador por diseño; la seguridad depende de las políticas RLS en Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SERVICE_ROLE KEY. SOLO para el servidor (route handlers, scripts).
# Bypasea TODAS las políticas RLS. Si esta clave se filtra, un atacante tiene
# acceso completo a la base de datos. NUNCA la importes en un Client Component
# y NUNCA la commitees al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Project ID del salón (UUID). Lo encuentras en Supabase -> Settings -> General.
# Es el project_id por defecto para el flujo de reserva pública en
# /reserva cuando el visitante aún no está autenticado.
NEXT_PUBLIC_PROJECT_ID=

# Secreto del cron de recordatorios (/api/cron/reminders).
# Vercel/Netlify lo envía en el header `x-cron-secret`. Si quieres habilitar
# el bypass de desarrollo (?dev=1) en staging, define ALLOW_CRON_BYPASS=true.
# Recomendado: dejar CRON_SECRET siempre configurado, incluso en staging.
CRON_SECRET=

# Bypass explícito del cron (true/false). NUNCA true en producción.
ALLOW_CRON_BYPASS=false

# Opcionales: si integras una API oficial de WhatsApp (Meta Cloud API u otra).
# Cuando están presentes, lib/whatsapp.ts intenta enviar por API en lugar de
# abrir el deep-link wa.me. Si no, usa siempre el fallback manual.
NEXT_PUBLIC_WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
